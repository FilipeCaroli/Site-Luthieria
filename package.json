{
  "dependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "bcryptjs": "^3.0.2",
    "connect-session-sequelize": "^8.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "moment": "^2.30.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.2.4"
  },
  "type": "module",
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.build.json && ncp src/views/ dist/src/views && ncp src/public/ dist/src/public",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "sass": "sass --watch src/scss/main.scss src/public/css/main.css",
    "dev": "nodemon --watch src --ext ts,ejs,css --exec tsx ./src/app.ts",
    "start": "node ./dist/src/app.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "base64-arraybuffer": "^1.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "ncp": "^2.0.0",
    "nodemon": "^3.1.14",
    "prettier": "3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
